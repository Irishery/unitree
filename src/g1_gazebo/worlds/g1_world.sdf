<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="g1_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />

    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.35 0.35 0.35 1</ambient>
      <background>0.75 0.8 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.3 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>
      </link>
    </model>

    <!-- A bounded navigation area gives the planar Mid-360 scan stable
         geometry in every direction and makes the generated SLAM map useful
         immediately after startup. -->
    <model name="navigation_walls">
      <static>true</static>
      <link name="link">
        <visual name="north_visual"><pose>0 3 1.25 0 0 0</pose><geometry><box><size>6.1 0.1 2.5</size></box></geometry><material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
        <collision name="north_collision"><pose>0 3 1.25 0 0 0</pose><geometry><box><size>6.1 0.1 2.5</size></box></geometry></collision>
        <visual name="south_visual"><pose>0 -3 1.25 0 0 0</pose><geometry><box><size>6.1 0.1 2.5</size></box></geometry><material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
        <collision name="south_collision"><pose>0 -3 1.25 0 0 0</pose><geometry><box><size>6.1 0.1 2.5</size></box></geometry></collision>
        <visual name="east_visual"><pose>3 0 1.25 0 0 0</pose><geometry><box><size>0.1 6.1 2.5</size></box></geometry><material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
        <collision name="east_collision"><pose>3 0 1.25 0 0 0</pose><geometry><box><size>0.1 6.1 2.5</size></box></geometry></collision>
        <visual name="west_visual"><pose>-3 0 1.25 0 0 0</pose><geometry><box><size>0.1 6.1 2.5</size></box></geometry><material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
        <collision name="west_collision"><pose>-3 0 1.25 0 0 0</pose><geometry><box><size>0.1 6.1 2.5</size></box></geometry></collision>
      </link>
    </model>

    <model name="table">
      <static>true</static>
      <link name="link">
        <visual name="top"><pose>0.60 0 0.75 0 0 0</pose><geometry><box><size>1.00 0.80 0.06</size></box></geometry><material><ambient>0.38 0.22 0.10 1</ambient><diffuse>0.50 0.30 0.14 1</diffuse></material></visual>
        <collision name="top"><pose>0.60 0 0.75 0 0 0</pose><geometry><box><size>1.00 0.80 0.06</size></box></geometry></collision>
        <visual name="leg_fl"><pose>0.18 0.32 0.36 0 0 0</pose><geometry><box><size>0.07 0.07 0.72</size></box></geometry></visual>
        <visual name="leg_fr"><pose>0.18 -0.32 0.36 0 0 0</pose><geometry><box><size>0.07 0.07 0.72</size></box></geometry></visual>
        <visual name="leg_rl"><pose>1.02 0.32 0.36 0 0 0</pose><geometry><box><size>0.07 0.07 0.72</size></box></geometry></visual>
        <visual name="leg_rr"><pose>1.02 -0.32 0.36 0 0 0</pose><geometry><box><size>0.07 0.07 0.72</size></box></geometry></visual>
        <collision name="leg_fl"><pose>0.18 0.32 0.36 0 0 0</pose><geometry><box><size>0.07 0.07 0.72</size></box></geometry></collision>
        <collision name="leg_fr"><pose>0.18 -0.32 0.36 0 0 0</pose><geometry><box><size>0.07 0.07 0.72</size></box></geometry></collision>
        <collision name="leg_rl"><pose>1.02 0.32 0.36 0 0 0</pose><geometry><box><size>0.07 0.07 0.72</size></box></geometry></collision>
        <collision name="leg_rr"><pose>1.02 -0.32 0.36 0 0 0</pose><geometry><box><size>0.07 0.07 0.72</size></box></geometry></collision>
      </link>
    </model>

    <model name="pickup_box">
      <pose>0.34 0 0.86 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <inertial><mass>0.25</mass><inertia><ixx>0.0011</ixx><iyy>0.0011</iyy><izz>0.0011</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.16 0.16 0.16</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.16 0.16 0.16</size></box></geometry><material><ambient>0.85 0.18 0.04 1</ambient><diffuse>0.95 0.22 0.05 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
