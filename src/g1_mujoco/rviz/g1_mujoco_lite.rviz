Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Displays:
    # Lightweight profile for software-GL laptops: the robot is shown as
    # the skeleton model (spheres per link, no meshes) from
    # /robot_description_lite published by description_relay.  Use the
    # full profile when the machine can render the textured meshes.
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Alpha: 1
      Enabled: true
      Name: G1 Skeleton
      Description Source: Topic
      Description Topic:
        Value: /robot_description_lite
      TF Prefix: ""
      Update Interval: 0
      Visual Enabled: true
      Collision Enabled: false
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: Mid-360 Scan
      Size (Pixels): 2
      Style: Points
      Topic:
        Reliability Policy: Best Effort
        Value: /scan
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Mid-360 3D Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mid360/points
      Size (m): 0.025
      Style: Points
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Local Costmap Voxels
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/voxel_points
      Size (m): 0.03
      Style: Points
      Value: true
    - Class: rviz_default_plugins/Map
      Alpha: 0.35
      Color Scheme: costmap
      Enabled: true
      Name: Local Costmap
      Topic:
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /local_costmap/costmap
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Nav2 Plan
      Topic:
        Reliability Policy: Reliable
        Value: /plan
      Value: true
  Global Options:
    Fixed Frame: map
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: nav2_rviz_plugins/GoalTool
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4.5
      Focal Point:
        X: 1.0
        Y: 0
        Z: 0.6
        Focal Shape Fixed Size: true
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.35
      Target Frame: <Fixed Frame>
      Yaw: 3.82
