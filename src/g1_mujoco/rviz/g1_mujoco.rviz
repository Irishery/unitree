Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Displays:
    # NOTE: no rviz_default_plugins/Map displays here on purpose.  RViz's
    # Map swatch rendering (indexed_8bit_image shader + vertex buffers)
    # crashes the whole GL context on this laptop's Mesa/amdgpu stack,
    # both with hardware GL and with llvmpipe.  The 2D nav profile
    # (g1_mujoco_nav.rviz) keeps the map/costmap panels when the machine
    # renders them correctly; this 3D profile shows the collision data as
    # the voxel point cloud instead.
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Alpha: 1
      Enabled: true
      Name: G1 DEX3
      Description Source: Topic
      Description Topic:
        Value: /robot_description_viz
      TF Prefix: ""
      Update Interval: 0
      Visual Enabled: true
      Collision Enabled: true
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Axes: false
      Show Names: false
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: Mid-360 Scan
      Size (Pixels): 3
      Style: Points
      Topic:
        Reliability Policy: Best Effort
        Value: /scan
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Mid-360 3D Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mid360/points
      Size (m): 0.025
      Style: Points
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Local Costmap Voxels
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/voxel_points
      Size (m): 0.03
      Style: Points
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Nav2 Plan
      Topic:
        Reliability Policy: Reliable
        Value: /plan
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: Detected Box Centre
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /g1/perception/box_marker
      Value: true
    # NOTE: no rviz_default_plugins/Image display here on purpose: it
    # crashes RViz on this laptop's Mesa stack even while disabled (GLSL
    # sampler conflict -> dead GL context -> "failed to create drawable"
    # spam and a segfault).  View the camera feed outside RViz instead.
  Global Options:
    Fixed Frame: map
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: nav2_rviz_plugins/GoalTool
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4.5
      Focal Point:
        X: 1.0
        Y: 0
        Z: 0.6
        Focal Shape Fixed Size: true
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.35
      Target Frame: <Fixed Frame>
      Yaw: 3.82
